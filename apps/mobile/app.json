{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f2a43",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "india.biocatalyst.app",
      "versionCode": 2
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "apiUrlComment": "The API base URL is read from EXPO_PUBLIC_API_URL at build/start time (default https://biocatalyst-india.vercel.app). See README.md."
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "india.biocatalyst.app",
      "buildNumber": "2",
      "icon": "./assets/icon.png",
      "supportsTablet": true
    },
    "name": "Biocatalyst India",
    "newArchEnabled": true,
    "orientation": "portrait",
    "plugins": [
      "./plugins/withAndroidReleaseSigning"
    ],
    "scheme": "biocatalyst-india",
    "slug": "biocatalyst-india",
    "splash": {
      "backgroundColor": "#0f2a43",
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "userInterfaceStyle": "light",
    "version": "1.0.1"
  }
}
