{
  "name": "@biocatalyst/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Biocatalyst India mobile app — Expo (managed workflow) + React Native + TypeScript (Milestone 9). Thin client over the existing /api/v1/* surface; no backend logic duplicated.",
  "main": "index.ts",
  "scripts": {
    "build": "expo export --output-dir dist",
    "dev": "expo start",
    "lint": "echo 'no linter configured for @biocatalyst/mobile (M9)'",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@biocatalyst/api-client": "workspace:*",
    "@biocatalyst/types": "workspace:*",
    "@expo/metro-runtime": "6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "expo": "54.0.37",
    "expo-constants": "18.0.14",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "15.0.8",
    "expo-status-bar": "3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/react": "19.1.17",
    "babel-preset-expo": "54.0.12",
    "jest-expo": "54.0.18",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.7.3"
  }
}
