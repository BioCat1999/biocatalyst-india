# Example only — never commit real values (spec §19).
# Milestone 0/1 needs none of these; they are placeholders for later milestones.
#
# Telemetry opt-outs (non-essential; nothing in the app depends on these).
# NEXT_TELEMETRY_DISABLED=1 disables Next.js CLI anonymous usage telemetry
# (the calls to telemetry.vercel.com you may see in devtools — collected by
# the Next.js CLI itself, not by our code, and not required for functioning).
# TURBO_TELEMETRY_DISABLED=1 does the same for Turborepo.
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1

DATABASE_URL=postgresql://biocatalyst:biocatalyst@localhost:5432/biocatalyst_dev
# ^ local-dev default (created by `pnpm db:setup`). Production will point at
# Supabase/managed Postgres via a real DATABASE_URL — never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# MODEL_PROVIDER selects the M4 extraction provider: "deterministic"
# (default — offline rule/template extractor, no network, no keys) or
# "mock" (fixture "model" with canned outputs for tests). Unknown values
# fall back to deterministic. Deliberately no MODEL_API_KEY: no real
# third-party model API is wired (see docs/decisions.md).
MODEL_PROVIDER=
# MARKET_DATA_PROVIDER selects the M5 market-data provider: "fixture"
# (default — offline illustrative price series, no network, no keys) or
# "yahoo" (real delayed daily NSE/BSE OHLCV bars via Yahoo Finance's
# unofficial keyless chart endpoint — personal/research use, no
# redistribution; no benchmark). Unknown values warn and fall back to
# fixture. Deliberately no market-data API key is needed (see
# docs/decisions.md).
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
APP_BASE_URL=http://localhost:3000
ADMIN_EMAILS=
# ADMIN_TOKEN gates POST /api/v1/admin/ingestion/run in non-development
# environments. Leave empty for local dev (the endpoint only runs when
# NODE_ENV=development or a valid Bearer token is presented). Never commit
# a real value.
ADMIN_TOKEN=
SENTRY_DSN=
# AUTH_SESSION_TTL_DAYS controls the M6 session lifetime (days, default 30).
# No auth API keys are needed: M6 auth is fully local (scrypt password
# hashing + DB-backed sessions, no third-party provider) — see
# docs/decisions.md.
AUTH_SESSION_TTL_DAYS=
