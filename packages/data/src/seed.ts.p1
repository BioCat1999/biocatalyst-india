/**
 * Seeded fixture data for Milestone 0/1.
 *
 * IMPORTANT — SEED FIXTURE DISCLAIMER:
 * Every record in this file is an illustrative fixture for local development
 * and UI prototyping. Companies, tickers, drugs, trials, events, source URLs,
 * timestamps and market-reaction numbers are realistic-looking placeholders —
 * they are NOT real announcements, NOT real trial outcomes, and NOT real
 * market data. The web app surfaces a "Seed fixture" badge wherever this
 * data is rendered. Milestone 3+ replaces these fixtures with verified,
 * source-backed records via compliant source adapters.
 *
 * Spec references: §1 (every fact needs source URL + timestamp — provided
 * below as fixture URLs), §4 (seeded JSON for M1 prototype), §5 (canonical
 * model), §6 (event taxonomy). Market reactions are NOT seeded here anymore:
 * Milestone 5 computes them from the fixture price series via the
 * market-reaction pipeline (see @biocatalyst/market-data and seed-db.ts).
 */
import type {
  CatalystEvent,
  Company,
  Drug,
  EventType,
  SourceRecord,
  Trial,
  TrialPhase,
  TrialStatus,
} from "@biocatalyst/types";

/* ------------------------------------------------------------------ */
/* Helpers                                                             */
/* ------------------------------------------------------------------ */

/** Build a source record with a retrieval timestamp shortly after publish. */
function src(
  id: string,
  title: string,
  publisher: string,
  url: string,
  publishedAt: string,
  retrievedAt: string,
  isPrimary: boolean,
): SourceRecord {
  return { id, title, publisher, url, publishedAt, retrievedAt, isPrimary };
}

